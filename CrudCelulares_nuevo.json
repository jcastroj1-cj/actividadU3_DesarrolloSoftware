{
  "info": {
    "name": "CRUD Celulares - Arquitectura Hexagonal",
    "description": "Colección completa de endpoints para la API REST de CRUD Celulares con arquitectura hexagonal. Usa Basic Auth con cédula y clave.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{cedula}}", "type": "string" },
      { "key": "password", "value": "{{clave}}", "type": "string" }
    ]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8080" },
    { "key": "cedula", "value": "12345678" },
    { "key": "clave", "value": "admin123" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST - Login usuario",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            },
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{cedula}}", "type": "string" },
                { "key": "password", "value": "{{clave}}", "type": "string" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Usuarios",
      "item": [
        {
          "name": "GET - Listar todos los usuarios",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/usuarios",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios"]
            }
          }
        },
        {
          "name": "GET - Buscar usuario por cédula",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/usuarios/12345678",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios", "12345678"]
            }
          }
        },
        {
          "name": "POST - Crear usuario",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cedula\": \"99999999\",\n  \"clave\": \"clave123\",\n  \"nombre\": \"Juan Pérez\",\n  \"email\": \"juan@email.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/usuarios",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios"]
            }
          }
        },
        {
          "name": "PUT - Actualizar usuario",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"clave\": \"nuevaclave123\",\n  \"nombre\": \"Juan Pérez Actualizado\",\n  \"email\": \"juan_nuevo@email.com\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/usuarios/99999999",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios", "99999999"]
            }
          }
        },
        {
          "name": "DELETE - Eliminar usuario",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/usuarios/99999999",
              "host": ["{{base_url}}"],
              "path": ["api", "usuarios", "99999999"]
            }
          }
        }
      ]
    },
    {
      "name": "Celulares",
      "item": [
        {
          "name": "GET - Listar todos los celulares",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/celulares",
              "host": ["{{base_url}}"],
              "path": ["api", "celulares"]
