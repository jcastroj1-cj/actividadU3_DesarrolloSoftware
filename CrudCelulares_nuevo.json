              "raw": "{\n  \"marca\": \"Samsung Galaxy S24\",\n  \"imei\": \"123456789012345\",\n  \"pulgadas\": 6.7,\n  \"megapixeles\": 200.0,\n  \"ram\": \"12GB\",\n  \"almacenamientoPrincipal\": \"256GB\",\n  \"almacenamientoSecundario\": null,\n  \"sistemaOperativo\": \"Android 14\",\n  \"operador\": \"Movistar\",\n  \"tecnologiaBanda\": \"5G\",\n  \"wifi\": true,\n  \"bluetooth\": true,\n  \"camaras\": 5,\n  \"marcaCpu\": \"Snapdragon 8 Gen 3\",\n  \"velocidadCpu\": \"3.39 GHz\",\n  \"nfc\": true,\n  \"huella\": true,\n  \"ir\": false,\n  \"resteAgua\": true,\n  \"cantidadSim\": 2\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/celulares/1",
              "host": ["{{base_url}}"],
              "path": ["api", "celulares", "1"]
            }
          }
        },
        {
          "name": "DELETE - Eliminar celular",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/celulares/1",
              "host": ["{{base_url}}"],
              "path": ["api", "celulares", "1"]
            }
          }
        }
      ]
    }
  ]
}
